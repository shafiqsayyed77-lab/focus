{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__vercel_path__=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__vercel_path__=/api/:path*"
    },
    {
      "source": "/((?!api|static|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}

