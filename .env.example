# FocusFlow Environment Configuration

# Security: Secret key for JWT signing (do not share in public repositories)
SECRET_KEY=focusflow_super_secret_jwt_key_change_in_production_2026

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_PATH=focusflow.db

# Optional AI Service: Google Gemini API Key
# If left empty, FocusFlow provides high-quality offline/mock AI responses
GEMINI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
